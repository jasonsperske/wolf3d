cabal-version: 2.4
name: wolf-haskell
version: 0.1.0.0
synopsis: A readable Wolfenstein-style Haskell teaching engine
build-type: Simple

common core
  default-language: Haskell2010
  ghc-options: -Wall -Wcompat -O2
  hs-source-dirs: src
  build-depends: base >=4.14 && <5, array >=0.5 && <0.6, containers >=0.6 && <0.9, bytestring >=0.10 && <0.13
  other-modules: Wolf.Assets, Wolf.Types, Wolf.Level, Wolf.Raycast, Wolf.Simulation, Wolf.Render

executable wolf-haskell
  import: core
  hs-source-dirs: app
  main-is: Main.hs
  c-sources: cbits/platform.c
  pkgconfig-depends: sdl2 >=2.0
  ghc-options: -rtsopts

test-suite core-tests
  import: core
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Main.hs

test-suite asset-tests
  import: core
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: AssetMain.hs
